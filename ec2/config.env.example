# Optional host-side defaults for ec2/run_training.sh.
export TCH_DATASET="tch_features_v10_productivity_history_snapshots"
# Either provide the full image URI or let the runner build the default ECR URI
# from AWS_ACCOUNT_ID / aws sts get-caller-identity.
export TCH_IMAGE=""
export AWS_ACCOUNT_ID=""
export TCH_ECR_REPOSITORY="tch-sagemaker-training"
export TCH_BUCKET="ndvi-extraction"
export AWS_REGION="us-east-1"
export TCH_WORK_ROOT="$HOME/tch-training"

# Safe defaults for an EC2 m5.xlarge host (4 vCPU, 16 GiB RAM).
export TCH_CPUS="4"
export TCH_MEMORY="14g"
export TCH_SHM_SIZE="2g"

export TCH_TRAIN_ZAFRAS="2020_2021,2021_2022,2022_2023,2023_2024"
export TCH_EVALUATION_ZAFRAS="2024_2025,2025_2026"
export TCH_SCORING_ZAFRAS="2026_2027"
export TCH_TARGET_MODE="residual_last_hist_tch"
export TCH_MODEL_TYPE="catboost"
export TCH_WEIGHT_MODE="snapshot_historical_tch"
export TCH_WEIGHT_MAX_MULTIPLIER="1.25"

# Optional exclusions. Keep empty unless a run-specific exclusion list is approved.
export TCH_EXCLUDE_FEATURES=""
